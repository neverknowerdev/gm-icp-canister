service: () -> {
    // Internal callbacks (called by ICP timer system)
    scannerCallback: () -> (null);
    cleanupCallback: () -> (null);

    // Basic
    greet: (text) -> (text) query;

    // Event processing
    handleEvent: (nat32, text) -> (null);

    // Configuration
    setContractAddresses: (record {
        contracts: record {
            "Base Mainnet": record { accountManager: text; GMCoin: text };
            "WorldChain": record { accountManager: text; GMCoin: text };
        };
    }) -> (null);

    setTwitterConfig: (record {
        tweetFetchURL: text;
        headerName: text;
        bearerTokenEncrypted: text;
    }) -> (null);

    setFarcasterConfig: (record {
        apiKeyEncrypted: text;
        apiUrl: opt text;
    }) -> (null);

    // User queries
    getUser: (nat64) -> (opt record {
        userId: nat64;
        chains: vec text;
        twitterId: nat64;
        farcasterId: nat64;
        isVerified: bool;
        verifications: vec text;
        primaryWallet: text;
        primaryChain: text;
        wallets: vec record { wallet: text; chain: text };
    }) query;

    getUserByTwitterId: (nat64) -> (opt record {
        userId: nat64;
        chains: vec text;
        twitterId: nat64;
        farcasterId: nat64;
        isVerified: bool;
        verifications: vec text;
        primaryWallet: text;
        primaryChain: text;
        wallets: vec record { wallet: text; chain: text };
    }) query;

    getUserByFarcasterId: (nat64) -> (opt record {
        userId: nat64;
        chains: vec text;
        twitterId: nat64;
        farcasterId: nat64;
        isVerified: bool;
        verifications: vec text;
        primaryWallet: text;
        primaryChain: text;
        wallets: vec record { wallet: text; chain: text };
    }) query;

    getUsers: (vec nat64) -> (vec record {
        userId: nat64;
        chains: vec text;
        twitterId: nat64;
        farcasterId: nat64;
        isVerified: bool;
        verifications: vec text;
        primaryWallet: text;
        primaryChain: text;
        wallets: vec record { wallet: text; chain: text };
    }) query;

    getTwitterUsers: (nat32, nat64, nat64) -> (vec record {
        userId: nat64;
        accountId: nat64;
        walletAddress: text;
    }) query;

    getFarcasterUsers: (nat32, nat64, nat64) -> (vec record {
        userId: nat64;
        accountId: nat64;
        walletAddress: text;
    }) query;

    // Wallet and encryption
    evmWalletAddress: () -> (text) query;
    encryptionPublicKey: () -> (text) query;

    // Transaction status
    getTransactionStatus: (nat32, text) -> (text) query;
}
