{
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=7.0.0"
  },
  "name": "gm-icp-canister",
  "private": true,
  "scripts": {
    "generate-config": "node scripts/generate-config.js",
    "build": "npm run generate-config && dfx build --network ic",
    "build:local": "npm run generate-config && dfx build",
    "deploy": "npm run generate-config && dfx deploy --network ic --identity mainnet",
    "deploy:account-manager": "npx ts-node scripts/deploy-account-manager.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@dfinity/candid": "^3.4.3",
    "@dfinity/principal": "^3.4.3",
    "@noble/ciphers": "^2.1.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^2.0.1",
    "azle": "0.33.0",
    "micro-eth-signer": "^0.18.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
